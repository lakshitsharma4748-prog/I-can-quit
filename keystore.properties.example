# Copy to keystore.properties (repo root, next to settings.gradle.kts) to
# sign release builds. keystore.properties is gitignored — never commit
# the real file, and never commit the .jks/.keystore file it points to
# either (also gitignored). See RELEASE.md for how to generate a keystore.

storeFile=/absolute/path/to/your-release-key.jks
storePassword=
keyAlias=
keyPassword=
