# Copy to .env for local development. Never commit the real .env file
# (it's already in .gitignore) — this file holds placeholders only.

# The port the server listens on. Railway sets this automatically in
# production; only needed for local development.
PORT=3000

# development | production | test
NODE_ENV=development

# Only needed once a database-backed data source exists (see
# src/database/README.md) — nothing in this backend reads it yet.
DATABASE_URL=

# Reserved for a future authenticated endpoint. Nothing in this backend
# currently requires it.
API_SECRET=

# Free-form identifier for where the blocklist data comes from. The
# current backend always serves its bundled JSON file regardless of this
# value (see src/services/blocklist.service.ts).
BLOCKLIST_SOURCE=bundled
